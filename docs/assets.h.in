/** @file @brief Build-time template for embedded OpenAPI and Swagger UI assets. */
#pragma once

/** @brief Constants generated by CMake from the documentation source files. */
namespace api::assets {
/// @brief Complete OpenAPI JSON document, generated from docs/openapi.json.
inline constexpr char openapi[] = R"openapi(@OPENAPI_JSON@)openapi";
/// @brief Swagger UI HTML page, generated from docs/swagger.html.
inline constexpr char swaggerUi[] = R"swagger(@SWAGGER_HTML@)swagger";
}
